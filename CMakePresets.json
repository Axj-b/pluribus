{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLURIBUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-gcc-debug",
      "displayName": "Windows GCC Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-gcc-release",
      "displayName": "Windows GCC Release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Windows Clang Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "wsl-gcc-debug",
      "displayName": "WSL GCC Debug (Unix Makefiles)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLURIBUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "wsl-gcc-release",
      "displayName": "WSL GCC Release (Unix Makefiles)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLURIBUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "wsl-codec-bench",
      "displayName": "WSL Codec Benchmark (Unix Makefiles)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Unix Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLURIBUS_BUILD_TESTS": "OFF",
        "PLURIBUS_BUILD_CODEC_BENCH": "ON"
      }
    },
    {
      "name": "macos-appleclang-debug",
      "displayName": "macOS AppleClang Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-gcc-debug",
      "configurePreset": "windows-gcc-debug"
    },
    {
      "name": "windows-gcc-release",
      "configurePreset": "windows-gcc-release"
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "wsl-gcc-debug",
      "configurePreset": "wsl-gcc-debug"
    },
    {
      "name": "wsl-gcc-release",
      "configurePreset": "wsl-gcc-release"
    },
    {
      "name": "wsl-codec-bench",
      "configurePreset": "wsl-codec-bench"
    },
    {
      "name": "macos-appleclang-debug",
      "configurePreset": "macos-appleclang-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-gcc-debug",
      "configurePreset": "windows-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-gcc-release",
      "configurePreset": "windows-gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-gcc-debug",
      "configurePreset": "wsl-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wsl-gcc-release",
      "configurePreset": "wsl-gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-appleclang-debug",
      "configurePreset": "macos-appleclang-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
